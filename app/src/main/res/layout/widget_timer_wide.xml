<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_wide_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_wide_sit_button"
            android:layout_width="54dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_segment_active_bg"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Sit"
            android:textAllCaps="false"
            android:textColor="#222B34"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widget_wide_stand_button"
            android:layout_width="60dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_segment_inactive_bg"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Stand"
            android:textAllCaps="false"
            android:textColor="#D9C6A5"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <Chronometer
            android:id="@+id/widget_wide_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FAF8F4"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_wide_static_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="45:00"
            android:textColor="#FAF8F4"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <Button
        android:id="@+id/widget_wide_toggle_button"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:background="@drawable/widget_button_bg"
        android:minWidth="72dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="Start"
        android:textAllCaps="false"
        android:textColor="#222B34"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
